# .env.example — copy to .env; never commit .env
POSTGRES_PASSWORD=replace-with-long-random-local-password
DATABASE_URL=postgresql+psycopg://banking_dev:replace-with-local-password@localhost:5432/banking_dev
NEO4J_AUTH=neo4j/replace-with-long-random-local-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-long-random-local-password
APP_ENV=local
OIDC_ISSUER=https://your-sandbox-identity-provider.example/realms/bank
OIDC_AUDIENCE=banking-rag-api
OIDC_JWKS_URL=https://your-sandbox-identity-provider.example/realms/bank/protocol/openid-connect/certs
OPENAI_API_KEY=replace-only-after-sandbox-approval
OPENAI_ROUTER_MODEL=approved-small-model-id
OPENAI_ANSWER_MODEL=approved-answer-model-id
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_API_KEY=replace-only-after-sandbox-approval
COHERE_RERANK_MODEL=rerank-v5.0-pro
LANGFUSE_PUBLIC_KEY=replace-only-after-approval
LANGFUSE_SECRET_KEY=replace-only-after-approval
LANGFUSE_BASE_URL=https://your-approved-langfuse-endpoint.example
LLM_ENABLED=false
